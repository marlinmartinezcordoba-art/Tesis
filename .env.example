# Copie este archivo a .env y complete los valores. El .env nunca se sube
# al repositorio.

# Clave con la que se firman las sesiones (mínimo 32 caracteres). Genérela con:
#   openssl rand -hex 32
RICORA_SECRET_KEY=

# Contraseña de la base de datos (solo la usa docker-compose).
POSTGRES_PASSWORD=

# Dirección con la que se arman los enlaces enviados por correo.
RICORA_URL_PUBLICA=http://localhost:8080
RICORA_PUERTO=8080

# Cuenta administradora que se crea o restablece en cada despliegue.
RICORA_ADMIN_CORREO=
RICORA_ADMIN_PASSWORD=
RICORA_ADMIN_NOMBRE=

# Correo transaccional (invitaciones y recuperación de contraseña).
# Con Gmail: EMAIL_HOST=smtp.gmail.com y una contraseña de aplicación.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Vigencias (valores por defecto; ver documentacion/modulo-autenticacion.md).
# MINUTOS_TOKEN_ACCESO=15
# MINUTOS_INACTIVIDAD_SESION=60
# HORAS_MAXIMAS_SESION=10
# MINUTOS_TOKEN_RECUPERACION=30
# HORAS_TOKEN_INVITACION=72

# Solo con HTTPS: la galleta de sesión viaja únicamente por conexión segura.
# RICORA_GALLETA_SEGURA=1
# RICORA_DETRAS_DE_PROXY=1
