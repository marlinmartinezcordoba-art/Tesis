# Copia este archivo a .env y completa los valores. .env nunca se sube al
# repositorio (está en .gitignore).

# Genera una clave propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-propia-y-secreta

DJANGO_DEBUG=1

# Dominios que pueden servir la aplicación, separados por comas.
# En local no hace falta tocarlo. En DigitalOcean: el dominio que te
# asigne App Platform o el de tu Droplet.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo en producción, detrás de un proxy con HTTPS (App Platform, o Nginx
# en un Droplet): pon esto en 1 y agrega tu dominio con https:// aquí.
DJANGO_BEHIND_PROXY=0
DJANGO_CSRF_TRUSTED_ORIGINS=

# Clave de la API de Anthropic, para el proveedor de IA en la nube
# (descripción asistida). Se crea en console.anthropic.com.
# Sin esta clave, el proveedor local (spaCy) sigue funcionando igual.
ANTHROPIC_API_KEY=

# Modelo de IA para la descripción asistida (opcional).
MAZUCA_MODELO_IA=claude-opus-5

# Contraseña de la base de datos de prueba en docker-compose (no se usa
# en producción; en DigitalOcean la base de datos gestionada da su propio
# DATABASE_URL).
POSTGRES_PASSWORD=mazuca

# Puerto de tu computador donde se abre MAZUCA con Docker Compose
# (http://localhost:MAZUCA_PUERTO/admin/). Cámbialo si el 8080 ya está
# ocupado en tu máquina.
MAZUCA_PUERTO=8080

# MAZUCA usa siempre PostgreSQL (nunca SQLite). Si ejecutas la aplicación
# sin Docker, deja esta línea vacía para usar el PostgreSQL local con los
# valores por defecto (ver README), o defínela con tu propia conexión:
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos
