# HTTPS automático para el nombre de RICORA (variable RICORA_DOMINIO).
# Caddy obtiene y renueva el certificado solo, y redirige http → https
# para ese nombre.
{$RICORA_DOMINIO} {
	encode gzip
	# Mientras la web se reinicia en un despliegue, Caddy retiene la petición y reintenta
	# cada segundo hasta 90 s en lugar de responder 502 (auditoría 5-11-2026).
	reverse_proxy web:8000 {
		lb_try_duration 90s
		lb_try_interval 1s
	}
}

# Quien entre por la dirección numérica (http://IP, enlaces antiguos) se
# envía al nombre con HTTPS. Redirección temporal (302): si el HTTPS fallara y
# el despliegue volviera a HTTP, los navegadores no la habrán memorizado.
http:// {
	redir https://{$RICORA_DOMINIO}{uri} 302
}
