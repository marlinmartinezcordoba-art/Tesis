# HTTPS de RICORA: Caddy obtiene y renueva solo el certificado gratuito de
# Let's Encrypt para RICORA_DOMINIO y pasa las solicitudes a la aplicación.
# Solo se usa en el servidor (perfil «https» de docker-compose).

{$RICORA_DOMINIO} {
	encode gzip
	reverse_proxy web:8000
}

# Quien entre por la dirección numérica llega al nombre con candado.
http:// {
	redir https://{$RICORA_DOMINIO}{uri} permanent
}
